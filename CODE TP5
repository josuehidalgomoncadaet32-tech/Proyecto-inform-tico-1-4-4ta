TP N° 5: Trabajando con ciclos (FOR)


int ledrojo = 11;
int ledazul = 10;
int ledverde = 9;
void setup()
{
  pinMode(11,OUTPUT);
  pinMode(10,OUTPUT);
  pinMode(9,OUTPUT);
}

void loop()
{
  for(int r = 0; r<=255; r += 12){
    for(int g=0; g<=255; g += 12){
    for(int b=0; b<=255; b += 12){
      analogWrite(ledrojo,r);
      analogWrite(ledverde,g);
      analogWrite(ledazul,b);
      delay(100);
   }
  }   
 }
}
